# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_WEBHOOK_SECRET=mys3cr3t  # Disable for Hookdeck CLI

# Testing Configuration
TEST_CHAT_ID=123456789  # Your Telegram chat ID (get it from logs after messaging bot)
TEST_WHATSAPP=34622035636  # Your WhatsApp number for testing (optional)

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here

# Primary LLM Provider (choose one)
GROQ_API_KEY=your_groq_api_key_here              # Recommended (fast & free)
# OPENAI_API_KEY=your_openai_api_key_here        # Alternative
# ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Alternative

# Speech-to-Text Provider (choose one)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here  # Recommended (scribe_v1)
# Or use OPENAI_API_KEY for Whisper

# Q&A Enhancement (optional but recommended)
LINKUP_API_KEY=your_linkup_api_key_here  # For web search in Q&A mode

# Image Generation (optional - add multiple for fallback reliability)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here  # Primary: Stable Diffusion, Flux, etc.
FAL_API_KEY=your_fal_api_key_here                  # Fallback 1: FLUX.1 (fast, high quality)
OPENAI_API_KEY=your_openai_api_key_here            # Fallback 2: DALL-E 3 (premium)
GEMINI_API_KEY=your_gemini_api_key_here            # Fallback 3: Imagen 3 (free tier)

# Video Generation (optional)
# FAL_API_KEY is also used for video generation (Fabric 1.0)

# Translation Service (optional but recommended)
LINGODEV_API_KEY=your_LINGODEV_API_KEY_here  # For multi-language support
LINGO_DEFAULT_TARGET=en                # Default target language
LINGO_STYLE=friendly                   # Translation style: friendly|technical|concise

# Provider Selection
STT_PROVIDER=elevenlabs    # or 'openai'
LLM_PROVIDER=groq          # or 'openai', 'anthropic'
IMAGE_PROVIDER=huggingface # or 'gemini' (gemini requires Vertex AI setup, experimental)

# Image Model Selection (for HuggingFace provider)
# Options (best to worst):
# - playgroundai/playground-v2.5-1024px-aesthetic (BEST - default, fast & high quality)
# - black-forest-labs/FLUX.1-dev (Excellent quality, may be slower)
# - stabilityai/stable-diffusion-3-medium-diffusers (Good, newer than SDXL)
# - stabilityai/stable-diffusion-xl-base-1.0 (Old default, okay quality)
IMAGE_MODEL=playgroundai/playground-v2.5-1024px-aesthetic

# WhatsApp Admin Notifications (Vonage)
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here
VONAGE_WHATSAPP_TO=34622035636              # Your admin WhatsApp number
VONAGE_WHATSAPP_FROM=14157386102            # Vonage sandbox number

# ============================================
# Admin Notification Settings
# ============================================
# Set to 'true' to enable notifications on each channel
# You can enable both, one, or neither

ENABLE_WHATSAPP_ADMIN=false  # WhatsApp (costs money, has rate limits)
ENABLE_DISCORD_ADMIN=true    # Discord (free, no limits, rich embeds!)

# Discord Admin Notifications (Webhook)
# Create a webhook in your Discord server:
# Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Hookdeck Configuration (not needed for CLI)
# HOOKDECK_TELEGRAM_URL=https://hkdk.events/...
# HOOKDECK_VONAGE_URL=https://hkdk.events/...

# Server Configuration
PORT=3020

