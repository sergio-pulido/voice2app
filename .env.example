# ============================================
# API Keys - Add at least one provider per category
# ============================================

# OpenAI (STT + LLM) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude (LLM) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Groq (Fast LLM) - https://console.groq.com/
GROQ_API_KEY=gsk_...

# ElevenLabs (STT + TTS) - https://elevenlabs.io/
ELEVENLABS_API_KEY=...

# ============================================
# Provider Selection
# ============================================

# STT Provider: "openai" | "elevenlabs"
STT_PROVIDER=elevenlabs

# LLM Provider: "openai" | "anthropic" | "groq"
LLM_PROVIDER=groq

# TTS Provider: "openai" | "elevenlabs" (not yet implemented)
TTS_PROVIDER=openai

# ============================================
# Telegram Configuration
# ============================================

TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=optional-secret

# ============================================
# Hookdeck Configuration (webhook relay)
# ============================================

HOOKDECK_URL=https://hkdk.events/your-endpoint
HOOKDECK_SECRET=optional-secret

# ============================================
# Server Configuration
# ============================================

PORT_GATEWAY=3020

# ============================================
# Model Settings
# ============================================

# Model name (depends on provider)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
LLM_MODEL=llama-3.3-70b-versatile

# Temperature for LLM (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# ============================================
# Runner Settings
# ============================================

RUNNER_TIMEOUT=30000
SCREENSHOT_DELAY=2000

# ============================================
# Debug Mode
# ============================================

DEBUG=false
